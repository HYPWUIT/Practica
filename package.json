{
  "name": "sage-and-oak",
  "private": true,
  "workspaces": [
    "client",
    "e2e",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "bun run --cwd client dev",
    "dev:server": "bun run --cwd server dev",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --cwd e2e test:e2e"
  }
}
