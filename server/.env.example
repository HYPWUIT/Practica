# Copy to .env and fill in. `prisma migrate dev` creates the database if the
# user has CREATEDB, which it also needs for the shadow database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sage_oak"

# Signs session cookies. Generate one with `bunx auth secret` or
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
CLIENT_ORIGIN="http://localhost:5173"
